# ── LedgerLive Web ── Cloud Run Production Dockerfile ─────────────────────
# Stage 1: Build the Vite application
FROM node:22-alpine AS build

WORKDIR /app

COPY apps/web/package.json apps/web/package-lock.json ./

RUN npm ci --ignore-scripts

COPY apps/web/ ./

RUN npm run build

# ── Stage 2: Serve with nginx on port 8080 (Cloud Run default) ────────────
FROM nginx:alpine AS production

RUN rm -rf /usr/share/nginx/html/* /etc/nginx/conf.d/default.conf

# Use the Cloud Run production nginx config (proxies to Cloud Run API URL)
COPY apps/web/nginx.cloud-run.conf /etc/nginx/conf.d/default.conf

COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -qO- http://localhost:8080/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
