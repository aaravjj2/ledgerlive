# LedgerLive — Environment Variables
# Copy this file to .env and adjust as needed.

# ── Core ─────────────────────────────────────────────────────
APP_MODE=DEMO                          # LOCAL | DEMO | PROD
E2E_MODE=1                             # 1 = enable E2E/golden scenario endpoints
LLM_PROVIDER=DEMO                      # DEMO | OLLAMA | OPENAI | GEMINI
SECRET_KEY=change-me-in-prod           # JWT signing key
OLLAMA_MODEL=devstral                  # LLM model for AI decisions

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./ledgerlive.db
# DATABASE_URL=postgresql+asyncpg://ledgerlive:ledgerlive@localhost:5432/ledgerlive

# ── Ports ────────────────────────────────────────────────────
API_PORT=8090                          # FastAPI backend
WEB_PORT=4173                          # Vite preview (production build)
WEB_DEV_PORT=5173                      # Vite dev server

# ── Gemini / Google Cloud ────────────────────────────────────
# GOOGLE_CLOUD_PROJECT=                # GCP project ID
# GEMINI_API_KEY=                      # Gemini API key
# GEMINI_MODEL=gemini-2.0-flash-live   # Model for voice interactions
# GOOGLE_APPLICATION_CREDENTIALS=      # Path to service account JSON

# ── DigitalOcean ─────────────────────────────────────────────
# DIGITALOCEAN_TOKEN=                  # DigitalOcean API token
# GRADIENT_AI_API_KEY=                 # Gradient AI inference key
# SPACES_ACCESS_KEY=                   # DigitalOcean Spaces
# SPACES_SECRET_KEY=                   # DigitalOcean Spaces

# ── Airia ────────────────────────────────────────────────────
AIRIA_ENDPOINT=https://api.airia.ai/v1/PROJECT_ID/PIPELINE_ID/execute
AIRIA_API_KEY=your_airia_api_key_here
# AIRIA_WEBHOOK_URL=                   # e.g. http://localhost:9099/webhook

# ── GitLab ───────────────────────────────────────────────────
# GITLAB_TOKEN=                        # GitLab personal access token

# ── Redis (optional) ────────────────────────────────────────
# REDIS_URL=redis://localhost:6379
