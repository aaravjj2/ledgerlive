# LedgerLive — Environment Variables
# Copy this file to .env and adjust as needed.

# ── Required ──────────────────────────────────────────────────
APP_MODE=DEMO                         # LOCAL | DEMO | PROD
E2E_MODE=1                            # 1 = enable E2E/golden scenario endpoints

# ── Optional ─────────────────────────────────────────────────
# OLLAMA_MODEL=devstral                # LLM model for AI decisions (default: devstral)
# LLM_PROVIDER=DEMO                    # DEMO | OLLAMA | OPENAI
# SECRET_KEY=change-me-in-prod         # JWT signing key

# ── Airia Integration (optional) ─────────────────────────────
# AIRIA_WEBHOOK_URL=                   # e.g. http://localhost:9099/webhook
                                       # When set, agent posts results to this URL
                                       # Leave empty to disable outbound webhooks

# ── Database (defaults to in-memory for DEMO) ────────────────
# DATABASE_URL=sqlite+aiosqlite:///./ledgerlive.db
# DATABASE_URL_SYNC=sqlite:///./ledgerlive.db

# ── Ports ────────────────────────────────────────────────────
# API_PORT=8090                        # FastAPI backend
# WEB_PORT=4173                        # Vite preview (production build)
# WEB_DEV_PORT=4174                    # Vite dev server
